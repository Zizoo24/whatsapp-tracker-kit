# ---------------------------------------------------------------------------
# whatsapp-tracker-kit configuration. Copy to `.env` and fill in.
# `.env` is gitignored and MUST stay that way — it holds the write secret.
# ---------------------------------------------------------------------------

# --- Durable store: Apps Script web app URL + shared secret ---
# Deploy apps-script/Code.gs as a Web App (Execute as Me / Access: Anyone), then
# paste the /exec URL here. The secret gates every write and always travels in the
# POST body, never a URL query string — a leaked read URL must not grant writes.
# Set the SAME secret as a Script Property named SHEET_SECRET in the Apps Script project.
SHEET_WEBHOOK_URL=
SHEET_SECRET=change-me-to-a-long-random-string

# --- Ingress: the local WhatsApp bridge ---
# Absolute paths. The sibling whatsapp.db (lid->phone map) is derived automatically
# by replacing the messages.db filename, so keep them in the same directory.
WHATSAPP_DB_PATH=/absolute/path/to/whatsapp-bridge/store/messages.db
WHATSAPP_BRIDGE_EXE=/absolute/path/to/whatsapp-bridge/whatsapp-bridge.exe
# The bridge's local REST server. /api/health requires the patch in bridge/.
WHATSAPP_BRIDGE_API=http://127.0.0.1:8080

# --- Alerting ---
# Digits only, no +. The pipeline sends failure alerts here via the bridge.
# Pointing this at the tracked account itself makes it a message-to-self.
TRACKER_ALERT_NUMBER=

# --- Model provider chain ---
# Comma-separated, tried in order. Supported: claude | codex | command
TRACKER_AGENT_PROVIDERS=claude,codex
# Absolute path to the Claude Code CLI. `claude setup-token` -> put the LONG-LIVED
# token on ONE line in agent-token.env (gitignored). A normal login token expires
# ~daily and a headless subprocess CANNOT refresh it. See docs/GUARDS.md #12.
TRACKER_CLAUDE_PATH=
TRACKER_CLAUDE_MODEL=claude-haiku-4-5-20251001
TRACKER_CODEX_PATH=
TRACKER_CODEX_MODEL=gpt-5.4-mini
# Generic stdin/stdout adapter for any other model runtime.
TRACKER_AGENT_COMMAND=
TRACKER_AGENT_ARGS_JSON=[]

# --- Behaviour ---
# IANA timezone for rendering dates into the store. A tracker for a local business must
# show the operator's civil day, not UTC — an evening record otherwise lands on the wrong
# date and every comparison against it reports a false one-day mismatch.
TRACKER_TIMEZONE=UTC
# Newest N messages sent to the model for a very long chat. Records conclude recently.
TRACKER_MAX_MSGS=250
# Context window (days) included for a counterparty chat, since a handoff spans days.
TRACKER_COUNTERPARTY_LOOKBACK_DAYS=5

# --- Payments (OPTIONAL) ---
# Restricted READ-ONLY key. This system NEVER writes to the payment processor.
# Leave blank to disable the reconciliation lane entirely.
STRIPE_KEY=
